    "@tanstack/react-router-devtools": "^1.146.2",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/router-vite-plugin": "^1.146.2",
    "@vercel/og": "^0.8.6",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "elysia": "^1.4.22",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "lucide-react": "^0.562.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^3.6.0",
    "tailwind-merge": "^3.4.0"
